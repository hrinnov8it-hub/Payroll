# =============================================================================
# Innov8IT Payroll — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# In Vercel: set these under Project → Settings → Environment Variables.
# NEVER commit .env.local to git.
# =============================================================================

# --- Supabase ---
# Your Supabase project API URL (visible in Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Your Supabase anon/public key (visible in Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
